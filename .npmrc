public-hoist-pattern[]=*@heroui/*
public-hoist-pattern[]=*@types/*
# jest-expo's setup.js requires this bare module; pnpm's isolated layout hides it
public-hoist-pattern[]=*@react-native/assets-registry*
# expo-updates hashes the autolinking paths inside node_modules/.pnpm, so every
# machine (including the EAS builder) must truncate those folder names the same
# way. Without this, a store installed with a different limit fails the build
# with "Runtime version calculated on local machine not equal to ... on EAS".
virtual-store-dir-max-length=60
