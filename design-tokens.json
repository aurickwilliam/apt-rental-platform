      "surface": "#1E1E1E",
      "surfaceRaised": "#2A2A2A",
      "primary": "#5B8BF7",
      "primaryLight": "#1A2340",
      "secondary": "#FFA500",
      "secondaryForeground": "#FFFFFF",
      "secondaryLight": "#2E2212",
      "textPrimary": "#F0F0F0",
      "textSecondary": "#9CA3AF",
      "gray500": "#6B7280",
      "gray400": "#6B7280",
      "gray300": "#3D3D3D",
