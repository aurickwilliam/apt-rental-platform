      "successLight": "#14291E",
      "warning": "#FDE047",
      "warningLight": "#2A2410",
      "danger": "#F87171",
      "dangerMid": "#FCA5A5",
      "dangerLight": "#2D1515"
    },
    "webTheme": {
      "light": {
        "background": "#F8F9FA",
        "foreground": "#333333",
        "card": "#FFFFFF",
        "cardForeground": "#333333",
        "popover": "#FFFFFF",
        "popoverForeground": "#333333",
        "primary": "#376BF5",
        "primaryForeground": "#FFFFFF",
        "secondary": "#FFA500",
        "secondaryForeground": "#FFFFFF",
        "muted": "#E5E7EB",
        "mutedForeground": "#6C757D",
        "accent": "#EFF6FF",
