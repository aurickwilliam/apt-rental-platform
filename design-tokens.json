        "destructive": "#E50914",
        "border": "#D1D5DB",
        "input": "#D1D5DB",
        "ring": "#376BF5",
        "radius": "0.625rem"
      },
      "dark": {
        "background": "oklch(0.17 0 0)",
        "foreground": "oklch(0.985 0 0)",
