{
  "$schema": "./design-tokens.schema.json",
  "$comment": "Canonical APT design tokens. Values are exact from packages/constants, apps/web/app/globals.css, apps/mobile/app/global.css, and heroui-native base variables. Values marked \"inferred\" derive from observed usage, not a declaration. See DESIGN.md §2 for authority and §24 for legacy tokens.",
  "version": "1.0.0",
  "sources": {
    "primary": "packages/constants/src/colors.ts",
    "typography": "packages/constants/src/typography.ts",
    "webTheme": "apps/web/app/globals.css",
    "mobileTheme": "apps/mobile/app/global.css",
    "herouiNativeBase": "apps/mobile/node_modules/heroui-native/lib/module/styles/variables.css"
  },

  "colors": {
    "light": {
      "white": "#FFFFFF",
      "surface": "#F8F9FA",
