{
  "name": "apt-rental-platform",
  "version": "1.0.0",
  "description": "APT is a modern rental platform designed for students, renters, and property owners. It simplifies the entire renting process—from searching for listings to managing properties—through a clean and user-friendly interface.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:mobile-registration:test": "node --experimental-strip-types --test scripts/mobile-registration/*.test.mjs",
    "db:web-registration:test": "node --experimental-strip-types --test scripts/web-registration/*.test.mjs",
    "db:billing:test": "node --experimental-strip-types --test scripts/billing/*.test.mjs",
    "db:tenant-reviews:test": "node --experimental-strip-types --test scripts/tenant-reviews/*.test.mjs",
    "db:landlord-gate:test": "node --experimental-strip-types --test scripts/verified-landlord/*.test.mjs",
    "web": "pnpm --filter web dev",
    "mobile": "pnpm --filter mobile start",
    "db:populate": "node --experimental-strip-types --import ./scripts/db-populate/register.mjs scripts/db-populate.mjs",
    "db:populate:test": "node --experimental-strip-types --import ./scripts/db-populate/register.mjs --test scripts/db-populate/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurickwilliam/apt-rental-platform.git"
  },
  "keywords": [],
  "author": "Aurick William Lorenzo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aurickwilliam/apt-rental-platform/issues"
  },
  "homepage": "https://github.com/aurickwilliam/apt-rental-platform#readme",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "metro-minify-terser": "^0.83.3"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
